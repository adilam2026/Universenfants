NODE_ENV="development"
DATABASE_URL="postgresql://universenfants:universenfants_dev@localhost:5432/universenfants?schema=public"
REDIS_URL="redis://localhost:6379"
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# Secret dédié au token de suivi de commande invité (après vérification OTP)
# — volontairement différent de JWT_ACCESS_SECRET, voir
# src/orders/guards/guest-order-tracking.guard.ts.
JWT_GUEST_TRACKING_SECRET="change-me-guest-tracking"

PORT=4000
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
API_PUBLIC_URL="http://localhost:4000"

# Stockage des images produit (Cloudflare R2, compatible S3). Laisser vide en
# développement : les images sont alors stockées sur disque local et servies
# via /uploads (voir src/storage/local-disk.provider.ts). Ce repli disque
# local NE SURVIT PAS aux redéploiements — à ne jamais laisser vide en
# production.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""
# Optionnel, repli disque local uniquement (R2 non configuré) : chemin de
# stockage des fichiers uploadés. Par défaut, un dossier "uploads" à côté de
# dist/. Sans intérêt si R2 est configuré.
# UPLOADS_DIR="/data/uploads"

# Emails transactionnels (SMTP). Laisser SMTP_HOST vide en développement :
# les emails sont alors journalisés dans apps/api/.mail-outbox/ (fichiers
# .html) au lieu d'être réellement envoyés (voir src/email/email.service.ts).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM_NAME="UniversEnfants"
MAIL_FROM_ADDRESS="no-reply@universenfants.ma"
WEB_PUBLIC_URL="http://localhost:3000"

# Suivi d'erreurs (Sentry). Laisser vide en développement : les erreurs sont
# alors seulement journalisées en console (voir src/instrument.ts).
SENTRY_DSN=""

# WhatsApp Business Cloud API (Meta) — envoi de l'OTP de suivi de commande
# invité. Laisser WHATSAPP_ACCESS_TOKEN vide en développement : le code OTP
# est alors seulement journalisé en console (voir src/whatsapp/whatsapp.service.ts).
# WHATSAPP_OTP_TEMPLATE_NAME doit correspondre à un message template
# pré-approuvé côté Meta Business Manager (catégorie "Authentication") —
# impossible à créer depuis ce projet, uniquement depuis leur compte.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE_NAME="otp_verification"
WHATSAPP_OTP_TEMPLATE_LANG="fr"
