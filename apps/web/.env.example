NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# URL publique du site, utilisée pour le sitemap et les métadonnées SEO.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Doit être IDENTIQUE à R2_PUBLIC_URL côté API (apps/api/.env.example) :
# next.config.ts en a besoin au build pour autoriser next/image à charger
# les images produit stockées sur R2 (images.remotePatterns). Laisser vide
# en développement (repli disque local, servi par l'API elle-même).
R2_PUBLIC_URL=""

# Suivi d'erreurs (Sentry), optionnel. Laisser vide en développement.
NEXT_PUBLIC_SENTRY_DSN=""
